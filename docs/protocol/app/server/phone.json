{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeffin.invalid/protocol/app/server/phone.json",
  "title": "phone",
  "description": "One new connection event.",
  "type": "object",
  "properties": {
    "type": {
      "const": "phone"
    },
    "item": {
      "type": "object",
      "required": [
        "ts",
        "ev"
      ],
      "properties": {
        "ts": {
          "type": "number"
        },
        "ev": {
          "enum": [
            "close",
            "first_frame",
            "paired",
            "ready",
            "stream",
            "ws_open",
            "ws_rejected"
          ]
        }
      },
      "description": "One metrics log record of the relay's connections: open, its fields depend on ev"
    }
  },
  "required": [
    "type",
    "item"
  ],
  "additionalProperties": false
}
