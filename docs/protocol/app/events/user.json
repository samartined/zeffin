{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeffin.invalid/protocol/app/events/user.json",
  "title": "chat.event: user",
  "description": "A message to the agent. In chat.event it also carries type and conversation; in chat.history it does not.",
  "type": "object",
  "properties": {
    "type": {
      "const": "chat.event"
    },
    "conversation": {
      "$ref": "../defs.json#/$defs/conversationId"
    },
    "n": {
      "type": "integer"
    },
    "at": {
      "type": "number"
    },
    "kind": {
      "const": "user"
    },
    "text": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/attachment"
      }
    },
    "via": {
      "const": "remote",
      "description": "It came from the other device (Remote Control)"
    }
  },
  "required": [
    "n",
    "at",
    "kind",
    "text"
  ],
  "additionalProperties": false
}
