{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeffin.invalid/protocol/app/events/notice.json",
  "title": "chat.event: notice",
  "description": "Something the app words in its language, by code, with data. In chat.event it also carries type and conversation; in chat.history it does not.",
  "type": "object",
  "properties": {
    "type": {
      "const": "chat.event"
    },
    "conversation": {
      "$ref": "../defs.json#/$defs/conversationId"
    },
    "n": {
      "type": "integer"
    },
    "at": {
      "type": "number"
    },
    "kind": {
      "const": "notice"
    },
    "code": {
      "enum": [
        "auto_unavailable",
        "flipper_mcp_failed",
        "api_retry",
        "compacted",
        "rate_limit",
        "remote_on",
        "remote_off",
        "remote_permission"
      ]
    },
    "data": {
      "type": "object"
    },
    "via": {
      "const": "remote",
      "description": "It came from the other device (Remote Control)"
    }
  },
  "required": [
    "n",
    "at",
    "kind",
    "code",
    "data"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "code": {
            "const": "auto_unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "mode": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "mode"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "flipper_mcp_failed"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "api_retry"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "attempt": {
                "type": "integer"
              },
              "max_retries": {
                "type": "integer"
              },
              "retry_delay_ms": {
                "type": "number"
              },
              "error_status": {
                "anyOf": [
                  {
                    "type": [
                      "integer",
                      "string"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "compacted"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "rate_limit"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string"
              },
              "resetsAt": {
                "type": "number"
              },
              "rateLimitType": {
                "type": "string"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "remote_on"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "remote_off"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "reason": {
                "enum": [
                  "off",
                  "deleted",
                  "server_restarted",
                  "server_stopped",
                  "idle",
                  "could_not_start",
                  "exited"
                ]
              },
              "exit": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "remote_permission"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "tool": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "tool"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
